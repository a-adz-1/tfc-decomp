From 759172d4a29da75fe4a06e458ea0b4648377bafd Mon Sep 17 00:00:00 2001
From: a-adz-1 <a-adz-1@proton.me>
Date: Mon, 9 Nov 2026 13:39:59 +0000
Subject: [PATCH 2/4] fix: pipebomb det on its own 0.6 s clock (server)

The det read the held weapon's attack timer, which reloading and weapon switching also set:
reloading blocked the det, and switching weapons skipped the launcher's delay.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/tfc/client.cpp |  4 ++--
 src/tfc/player.cpp |  4 ++--
 src/tfc/player.h   |  1 +
 src/tfc/tfort.cpp  | 12 ++++++++++++
 4 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/src/tfc/client.cpp b/src/tfc/client.cpp
index 659958d..ae78c76 100644
--- a/src/tfc/client.cpp
+++ b/src/tfc/client.cpp
@@ -950,8 +950,8 @@ void ClientCommand( edict_t *pEntity )
 
 	if ( FStrEq( pcmd, "detpipe" ) )
 	{
-		// Pipebombs can't go off until the launcher can fire again
-		if ( pPlayer->m_pActiveItem && ( (CBasePlayerWeapon *)pPlayer->m_pActiveItem )->m_flNextPrimaryAttack <= 0 )
+		// Pipebombs can't go off within 0.6 s of firing one
+		if ( pPlayer->PipebombsCanDet() )
 			pPlayer->ExplodeOldPipebomb( TRUE, FALSE );
 	}
 	else if ( FStrEq( pcmd, "throwgren" ) || FStrEq( pcmd, "-gren1" ) || FStrEq( pcmd, "-gren2" ) )
diff --git a/src/tfc/player.cpp b/src/tfc/player.cpp
index 23d4628..f069207 100644
--- a/src/tfc/player.cpp
+++ b/src/tfc/player.cpp
@@ -7185,8 +7185,8 @@ void CBasePlayer::UseSpecialSkill( void )
 		break;
 
 	case PC_DEMOMAN:
-		// Detonate pipebombs
-		if ( m_pActiveItem && ( (CBasePlayerWeapon *)m_pActiveItem )->m_flNextPrimaryAttack <= 0 )
+		// Detonate pipebombs (not within 0.6 s of firing one)
+		if ( PipebombsCanDet() )
 			ExplodeOldPipebomb( TRUE, FALSE );
 		break;
 
diff --git a/src/tfc/player.h b/src/tfc/player.h
index abcaf05..98d24ec 100644
--- a/src/tfc/player.h
+++ b/src/tfc/player.h
@@ -414,6 +414,7 @@ public:
 	virtual void TeamFortress_TakeConcussionBlast(entvars_t *, float);
 	virtual void TeamFortress_Concuss(entvars_t *);
 	void ExplodeOldPipebomb(BOOL, BOOL);
+	BOOL PipebombsCanDet(void);	// fix: the det rule on its own clock
 	void RemovePipebombs();
 	void Engineer_RemoveBuildings();
 	void TeamFortress_RemoveBuildings();
diff --git a/src/tfc/tfort.cpp b/src/tfc/tfort.cpp
index 91226c9..19c91a9 100644
--- a/src/tfc/tfort.cpp
+++ b/src/tfc/tfort.cpp
@@ -220,6 +220,18 @@ void CBasePlayer::ExplodeOldPipebomb( BOOL bAll, BOOL bForceDetonation )
 	}
 }
 
+// Fix (det blocked by reloading): the rule is "no det within 0.6 s of firing a pipe". It used to read the
+// held weapon's attack timer, which reloading and weapon switching also set; read the newest pipe's age instead.
+BOOL CBasePlayer::PipebombsCanDet( void )
+{
+	for ( CBaseEntity *pEnt = UTIL_FindEntityByClassname( NULL, "tf_gl_pipebomb" ); pEnt; pEnt = UTIL_FindEntityByClassname( pEnt, "tf_gl_pipebomb" ) )
+	{
+		if ( CBaseEntity::Instance( pEnt->pev->owner ) == this && ((CTFGrenade *)pEnt)->m_flCreationTime + 0.6 > gpGlobals->time )
+			return FALSE;
+	}
+	return TRUE;
+}
+
 void CBasePlayer::RemovePipebombs( void )
 {
 	CBaseEntity *pEnt = UTIL_FindEntityByClassname( NULL, "tf_gl_pipebomb" );
-- 
