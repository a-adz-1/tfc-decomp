+			m_pSpot->pev->rendercolor = TF_TeamColour( m_pPlayer->team_no );
+			m_pSpot->pev->scale = 0.3;
+		}
+#endif
 	}
 
 	UTIL_MakeVectors( m_pPlayer->pev->v_angle );
